{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(rustfmt:*)",
      "Bash(busctl --user list:*)",
      "Bash(busctl --user introspect:*)",
      "Bash(niri msg --json:*)",
      "Bash(umbriel windows:*)",
      "Bash(umbriel focused-window:*)",
      "Bash(journalctl --user:*)"
    ]
  },
  "env": {
    "RUST_LOG": "noctalia_appmenu_bridge=debug,zbus=info"
  }
}
